{
  "name": "docs-cloud",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-05-15",
  "routes": [{ "pattern": "docs.upliftedconsulting.com", "custom_domain": true }],
  // The SPA is served from Vite's build output. API, socket and MCP paths run
  // the Worker first; everything else falls back to index.html.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "docs-cloud",
      // Replace with the id printed by `wrangler d1 create docs-cloud` before the first deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "DOC_ROOM", "class_name": "DocRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocRoom"] }],
  "vars": {
    "OWNER_EMAILS": "riccardo@upliftedconsulting.com,riccardo.vandra@bark.com,riccardo.vandra@gmail.com",
    "EMAIL_FROM": "Docs <docs@upliftedconsulting.com>",
  },
  // Secret: RESEND_API_KEY (`wrangler secret put RESEND_API_KEY`). Unset locally,
  // codes are printed to the wrangler dev console.
}
