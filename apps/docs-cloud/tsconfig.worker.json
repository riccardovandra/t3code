{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "@effect/language-service",
        // This app does not use Effect; it runs on plain Web and Workers APIs.
        "diagnosticSeverity": {
          "globalDate": "off",
          "globalConsole": "off",
          "globalRandom": "off",
          "globalTimers": "off",
          "globalFetch": "off",
          "cryptoRandomUUID": "off",
          "nodeBuiltinImport": "off"
        }
      }
    ],
    "target": "ES2023",
    "lib": ["ES2023", "WebWorker"],
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["src/worker", "src/shared"]
}
